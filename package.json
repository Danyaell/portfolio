{
  "name": "danyaell-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content:generate": "node scripts/generate-content.mjs",
    "postinstall": "npm run content:generate",
    "prestart": "npm run content:generate",
    "start": "ng serve",
    "prebuild": "npm run content:generate",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:danyaell-portfolio": "node dist/danyaell-portfolio/server/server.mjs",
    "validate": "npm run content:generate && npm run lint && npm run format:check && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "marked": "^18.0.9",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  }
}
